PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cashflow
# Comma-separated frontend origins
CORS_ORIGIN=http://localhost:3000
# Optional: allow all Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# ------------------------------------------------------------------
# Safaricom Daraja M-Pesa (sandbox)
# Get credentials at https://developer.safaricom.co.ke
# ------------------------------------------------------------------
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

DARAJA_AUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
DARAJA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest

# Must be a publicly reachable HTTPS URL — use ngrok or similar in local dev.
# Example: https://abc123.ngrok.io/api/mpesa/callback
DARAJA_CALLBACK_URL=

# ------------------------------------------------------------------
# Safaricom Daraja Business Buy Goods (B2B) — sandbox
# Required for the B2B payment method.
# Initiator and SecurityCredential come from your Daraja portal app.
# PartyA = shortcode sending funds. PartyB = receiver shortcode.
# ResultURL/QueueTimeOutURL MUST be public HTTPS (use ngrok for local dev).
# ------------------------------------------------------------------
DARAJA_B2B_URL=https://sandbox.safaricom.co.ke/mpesa/b2b/v1/paymentrequest
DARAJA_B2B_INITIATOR=
DARAJA_B2B_SECURITY_CREDENTIAL=
DARAJA_B2B_PARTY_A=
DARAJA_B2B_PARTY_B=
DARAJA_B2B_RESULT_URL=
DARAJA_B2B_QUEUE_TIMEOUT_URL=

# ------------------------------------------------------------------
# Optional integrations
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
