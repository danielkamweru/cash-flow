PORT=4000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wealthloop
# Comma-separated frontend origins (Vercel production + local)
CORS_ORIGIN=http://localhost:3000
# Optional: allow all Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
JWT_SECRET=wealth-loop-dev-secret-change-me
JWT_EXPIRE_HOURS=72

LOOP_BASE_URL=https://sandbox.loop.co.ke
LOOP_GATEWAY_BASE_URL=https://sandbox.loop.co.ke/gateway
# Use your Render public URL in production, e.g. https://wealth-loop-api.onrender.com
LOOP_CALLBACK_BASE_URL=https://httpbin.org
LOOP_CONSUMER_KEY=
LOOP_CONSUMER_SECRET=
LOOP_DEFAULT_TILL=133239
LOOP_DEFAULT_TILL_SECRET=

# Optional integrations
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New-format Gemini Authentication Key (AQ. prefix) — sent via x-goog-api-key header
GEMINI_API_KEY=
